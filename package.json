{
  "name": "opentool-mesh",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "corepack pnpm -r run build",
    "dev": "turbo run dev --parallel",
    "lint": "corepack pnpm -r run lint",
    "test": "corepack pnpm -r run test",
    "typecheck": "corepack pnpm -r run typecheck",
    "demo:publish": "node --experimental-strip-types scripts/publish-tool.ts",
    "demo:seed": "node --experimental-strip-types scripts/seed-capability-index.ts",
    "demo:run": "node --experimental-strip-types scripts/demo-run.ts",
    "demo:tool-node": "corepack pnpm --filter @opentoolmesh/tool-node build && node services/tool-node/dist/services/tool-node/src/server.js",
    "demo:audit-agent": "corepack pnpm --filter @opentoolmesh/audit-agent build && node examples/audit-agent/dist/examples/audit-agent/src/run-audit.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
