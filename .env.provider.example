# Copy to .env.provider and replace every placeholder with real testnet values.
# .env.provider is gitignored and must not be committed.

OTM_PROVIDER_PROFILE=provider-testnet

OTM_ENS_PROVIDER=ens
OTM_ENS_RPC_URL=https://your-sepolia-rpc
OTM_ENS_NAME=your-tool-name.example.eth
OTM_ENS_PUBLISHER_PRIVATE_KEY=0xreplace_with_32_byte_private_key

OTM_STORAGE_PROVIDER=0g
OTM_0G_RPC_URL=https://evmrpc-testnet.0g.ai
OTM_0G_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai
OTM_0G_PRIVATE_KEY=0xreplace_with_32_byte_private_key
OTM_0G_KV_NODE_URL=https://your-0g-kv-node
# Generate with:
# node -e "const crypto=require('node:crypto'); console.log('0x'+crypto.randomBytes(32).toString('hex'))"
OTM_0G_KV_STREAM_ID=0xreplace_with_32_byte_stream_id

# For a true Gensyn AXL smoke, use the local AXL node API, normally http://127.0.0.1:9002.
# For bridge-only local testing, point this at the tool node, normally http://127.0.0.1:4318.
OTM_GENSYN_AXL_API_URL=http://127.0.0.1:9002
