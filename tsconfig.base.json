{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "@opentoolmesh/shared": ["packages/shared/src/index.ts"],
      "@opentoolmesh/sdk": ["packages/sdk/src/index.ts"],
      "@opentoolmesh/mcp-server": ["packages/mcp-server/src/index.ts"]
    }
  }
}
